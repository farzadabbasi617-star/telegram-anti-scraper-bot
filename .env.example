# ================================================================
# .env.example — الگوی متغیرهای محیطی (کپی کن در .env)
# برای Production در Render: همین نام‌ها را در Environment Variables ثبت کن
# ================================================================

# --- الزامی ---
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
API_ID=2040
API_HASH=0123456789abcdef0123456789abcdef
ADMIN_ID=564234793
DATABASE_URL=postgresql://user:pass@host:port/db?sslmode=require

# --- سرور و مینی‌اپ ---
PORT=10000
RENDER_EXTERNAL_URL=https://telegram-anti-scraper-bot.onrender.com
KEEP_ALIVE_INTERVAL=280

# --- دیتابیس و امنیت ---
DB_POOL_SIZE=6
# در صورت تعریف، سشن‌های اکانت‌ها به‌صورت رمزنگاری‌شده در دیتابیس ذخیره می‌شوند:
SESSION_ENCRYPTION_KEY=

# --- موتور ادد (ضد بن) ---
MAX_ADD_PER_ACCOUNT=100
CAP_ULTRA=50
CAP_FAST=100
CAP_SAFE=100
DEFAULT_TARGET_USERNAME=gament_super_gp
FIXED_TARGET_LINK=https://t.me/+gLScToU4DZdjZmM0

# --- لاگینگ ---
LOG_DIR=logs
LOG_LEVEL=INFO
